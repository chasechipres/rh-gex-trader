{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat .env*)",
      "Bash(*printenv*)",
      "Bash(env)",
      "Bash(git push --force*)",
      "Edit(./private/state/**)",
      "Edit(./rhgex/hook.py)",
      "Edit(./rhgex/guardrails.py)",
      "Edit(./rhgex/dailyloss.py)",
      "Edit(./rhgex/exits.py)",
      "Edit(./rhgex/paths.py)"
    ],
    "allow": [
      "Bash(uv run python -m rhgex research*)",
      "Bash(uv run python -m rhgex gex*)",
      "Bash(uv run python -m rhgex check*)",
      "Bash(uv run python -m rhgex blocks*)",
      "Bash(uv run python -m rhgex journal*)",
      "Bash(uv run python -m rhgex exits*)",
      "Bash(uv run python -m rhgex plan*)",
      "Bash(uv run python -m rhgex record*)",
      "Bash(uv run python -m rhgex wash*)",
      "Bash(uv run python -m rhgex sync*)",
      "Bash(uv run python -m rhgex init --check*)",
      "Edit(./private/notes/**)"
    ],
    "ask": [
      "Edit(./private/guardrails.toml)",
      "Edit(./templates/private/guardrails.toml)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "enabledMcpjsonServers": [
    "robinhood-trading"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/private/guardrails.toml\" ] && [ -d \"$CLAUDE_PROJECT_DIR/.venv\" ]; then echo '{\"systemMessage\": \"Start the trading day with /trading-day\"}'; else echo '{\"systemMessage\": \"Not set up on this machine yet: run /setup\"}'; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__robinhood-trading__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { PY=.venv/bin/python; [ -x .venv/Scripts/python.exe ] && PY=.venv/Scripts/python.exe; \"$PY\" -m rhgex hook pre; } || { echo 'rhgex guardrail hook failed to run; blocking Robinhood call' >&2; exit 2; }"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__robinhood-trading__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PY=.venv/bin/python; [ -x .venv/Scripts/python.exe ] && PY=.venv/Scripts/python.exe; \"$PY\" -m rhgex hook post"
          }
        ]
      }
    ]
  }
}

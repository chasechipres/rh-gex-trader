# Synced: guardrails.toml, CLAUDE.md, README.md, notes/, logs/journal.jsonl, logs/wash_sales.jsonl,
# state/plans.json, state/ledger.jsonl, state/session.lock. Everything else in logs/ and state/ stays local.
state/*
!state/plans.json
!state/ledger.jsonl
!state/session.lock
logs/*
!logs/journal.jsonl
!logs/wash_sales.jsonl
*.log
.env
.env.*
